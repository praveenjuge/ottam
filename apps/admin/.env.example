# Public browser configuration
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
NEXT_PUBLIC_CONVEX_URL=https://replace-me.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://replace-me.convex.site

# Server-only configuration
CLERK_SECRET_KEY=replace_me
CLERK_FRONTEND_API_URL=https://replace-me.clerk.accounts.dev
OTTAM_ADMIN_EMAIL=hello@praveenjuge.com
OTTAM_ADMIN_CLERK_USER_ID=user_replace_me

# AI SDK routes through Vercel AI Gateway. Vercel deployments use OIDC.
# Local development receives a short-lived VERCEL_OIDC_TOKEN from `vercel env pull`.
OTTAM_STUDIO_MODEL=deepseek/deepseek-v4-flash-0731
VERCEL_OIDC_TOKEN=replace_me

# Private media. R2 keys must be scoped to the named private buckets.
R2_ACCOUNT_ID=replace_me
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_EDITORIAL_BUCKET=ottam-editorial
R2_RELEASE_BUCKET=ottam-releases

# Audio generation is invoked only after an explicit studio approval.
# Keep this separate from the restricted health-check key.
ELEVENLABS_API_KEY=replace_me
ELEVENLABS_DAILY_CREDIT_CEILING=25000
